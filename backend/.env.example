# --- Database ---
# Dev default uses SQLite (auto-creates, no setup). For PostgreSQL use the line below.
DATABASE_URL=postgresql+asyncpg://aso:aso_dev@localhost:5432/aso_light
# DATABASE_URL=sqlite+aiosqlite:///./aso_light.db

# --- App secrets ---
# REQUIRED. Each must be a unique random string of at least 32 characters.
# The app refuses to start if either is empty, a placeholder, or too short.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Fernet key — encrypts uploaded .p8 keys at rest. REQUIRED.
# The app refuses to start if this is empty or not a valid Fernet key.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Exchange rates ---
# Free public rate-cache service (166 currencies, no auth, hourly cache).
# Swap for your own deployment of github.com/overx-ai/rate-cache-api if you prefer.
RATE_CACHE_API_URL=https://api.overx.ai

# --- CORS ---
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]

# --- Optional: AI translation (Metadata Editor + review translate) ---
# Translation runs an automatic provider fallback chain (TRANSLATION_PROVIDER_CHAIN).
# Providers without a key are skipped; if NONE are set, /translate returns 503.
# Cap is 500 translations / app / 30 days (cached after the first call).
#
# OpenRouter (openrouter.ai) — OpenAI-compatible gateway; one key fans out to many
# upstream models. Default for the chain below.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model slug; see openrouter.ai/models (e.g. google/gemini-2.0-flash-001, openai/gpt-4o-mini).
OPENROUTER_TRANSLATION_MODEL=anthropic/claude-3.5-haiku
#
# Anthropic direct — get a key from console.anthropic.com.
ANTHROPIC_API_KEY=
#
# Ordered, comma-separated provider chain (first = primary, rest = fallbacks).
TRANSLATION_PROVIDER_CHAIN=openrouter,anthropic

# --- Apple Search Ads (optional) ---
# No env vars are needed: ASA credentials (clientId, teamId, .p8 key) are entered
# in-app via Settings and stored Fernet-encrypted in the database. The Paid Search
# features stay hidden until at least one ASA credential is added.
