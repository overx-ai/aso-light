# --- Database ---
# Dev default uses SQLite (auto-creates, no setup). For PostgreSQL use the line below.
DATABASE_URL=postgresql+asyncpg://aso:aso_dev@localhost:5432/aso_light
# DATABASE_URL=sqlite+aiosqlite:///./aso_light.db

# --- App secrets ---
# Use long random strings in production.
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Fernet key — encrypts uploaded .p8 keys at rest. REQUIRED to store credentials.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Exchange rates ---
# Free public rate-cache service (166 currencies, no auth, hourly cache).
# Swap for your own deployment of github.com/overx-ai/rate-cache-api if you prefer.
RATE_CACHE_API_URL=https://api.overx.ai

# --- CORS ---
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]

# --- Optional: AI translation (Metadata Editor) ---
# Get a key from console.anthropic.com. Translations use claude-haiku-4-5 by default.
# Cap is 500 translations / app / 30 days (cached after the first call).
# Without this set, the /translate endpoint returns 503 and the UI button is disabled.
ANTHROPIC_API_KEY=

# --- Apple Search Ads (optional) ---
# No env vars are needed: ASA credentials (clientId, teamId, .p8 key) are entered
# in-app via Settings and stored Fernet-encrypted in the database. The Paid Search
# features stay hidden until at least one ASA credential is added.
